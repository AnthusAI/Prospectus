{
  "name": "prospectus-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "synth": "cdk synth --quiet",
    "check": "npm run build && npm test && npm run synth",
    "check:amplify": "tsc --noEmit --module esnext --moduleResolution bundler --target es2022 --skipLibCheck ../amplify/backend.ts",
    "synth:amplify-review": "cd .. && node --import tsx infra/scripts/synth-amplify-review.ts",
    "synth:accounts:review": "cd .. && node --import tsx infra/scripts/synth-accounts-review.ts"
  },
  "dependencies": {
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "aws-cdk": "2.1144.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module"
}
